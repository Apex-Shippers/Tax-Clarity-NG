---
import TaxCalculator from '../components/TaxCalculator.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tax Clarity NG — Nigeria's smartest PAYE calculator built on the 2026 Nigeria Tax Act. Calculate your take-home pay, deductions, and effective tax rate instantly." />
    <meta name="theme-color" content="#008751" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>Tax Clarity NG — 2026 PAYE Calculator</title>
  </head>
  <body class="bg-cream min-h-screen font-sans antialiased selection:bg-ng-green/30 selection:text-charcoal">

    <!-- Subtle background pattern -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.03]"
         style="background-image: radial-gradient(#121212 1px, transparent 1px); background-size: 24px 24px;">
    </div>

    <main class="relative z-10 flex flex-col items-center justify-start py-8 sm:py-12 min-h-screen">
      <TaxCalculator />

      <!-- How It Works CTA -->
      <div class="mt-10 text-center">
        <a href="/how-it-works"
           class="neo-card inline-flex items-center gap-3 bg-white text-charcoal px-6 py-3.5 text-base font-extrabold rounded-2xl hover:-translate-x-1 hover:-translate-y-1 active:translate-x-0.5 active:translate-y-0.5 transition-all duration-150 group">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-ng-green text-white text-sm font-black border-2 border-charcoal">?</span>
          How does this work?
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-charcoal/50 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Footer -->
      <footer class="mt-12 mb-8 text-center text-sm text-charcoal/70 font-medium space-y-1.5 max-w-md mx-auto px-4">
        <p>Built on the <strong class="text-charcoal">2026 Nigeria Tax Act (NTA)</strong></p>
        <p>This is an educational tool. Consult a tax professional for official advice.</p>
        <div class="flex items-center justify-center gap-2 pt-2">
          <span class="w-3 h-3 rounded-full bg-ng-green border border-charcoal/30"></span>
          <span class="w-3 h-3 rounded-full bg-white border border-charcoal/30"></span>
          <span class="w-3 h-3 rounded-full bg-ng-green border border-charcoal/30"></span>
        </div>
      </footer>
    </main>
  </body>
</html>
