---
/**
 * TaxCalculator.astro
 * Self-contained interactive PAYE calculator component.
 * All interactivity runs client-side in the <script> block — zero framework overhead.
 */
---

<!--STEP 1 — GROSS INCOME CARD -->
<section id="calc-root" class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">

  <!-- Header -->
  <header class="text-center mb-4">
    <div class="inline-flex items-center gap-2 mb-4">
      <span class="inline-block w-4 h-4 rounded-full bg-ng-green border-2 border-charcoal"></span>
      <span class="inline-block w-4 h-4 rounded-full bg-white border-2 border-charcoal"></span>
      <span class="inline-block w-4 h-4 rounded-full bg-ng-green border-2 border-charcoal"></span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-charcoal tracking-tight leading-tight">
      Tax Clarity <span class="text-ng-green">NG</span>
    </h1>
    <p class="mt-2 text-base sm:text-lg text-charcoal/70 font-medium max-w-xl mx-auto">
      Nigeria's smartest PAYE calculator built on the <strong class="text-charcoal">2026 Tax Act</strong>
    </p>
  </header>

  <!--  Income Input Card -->
  <div class="neo-card bg-white p-6 sm:p-8 transition-all duration-200">
    <label for="grossIncome" class="block text-xl sm:text-2xl font-extrabold text-charcoal mb-1">
      What is your Gross Annual Income?
    </label>
    <p class="text-sm text-charcoal/60 mb-5 flex items-start gap-2">
      <span class="inline-flex items-center justify-center shrink-0 w-5 h-5 rounded-full bg-ng-green/15 text-ng-green text-xs font-bold mt-0.5">i</span>
      <span>Under the <strong>2026 NTA</strong>, the first <strong>₦800,000</strong> of your chargeable income is <em>entirely tax-free</em>.</span>
    </p>
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-bold text-charcoal/50 select-none pointer-events-none">₦</span>
      <input
        id="grossIncome"
        type="text"
        inputmode="numeric"
        placeholder="e.g. 5,000,000"
        autocomplete="off"
        class="neo-input w-full pl-10 pr-4 py-4 text-xl sm:text-2xl font-bold text-charcoal bg-cream placeholder:text-charcoal/25 focus:outline-none focus:ring-2 focus:ring-ng-green/40"
      />
    </div>
  </div>

  <!--  Rent & Pension Card (hidden until income > 800k) ─ -->
  <div id="deductionsCard" class="neo-card bg-white p-6 sm:p-8 transition-all duration-300 hidden opacity-0 translate-y-6">

    <!-- Rent input -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-3 mb-1">
        <label for="rentPaid" class="text-xl sm:text-2xl font-extrabold text-charcoal">
          Annual Rent Paid
        </label>
        <span class="neo-badge">
          New 2026 Benefit
        </span>
      </div>
      <p class="text-sm text-charcoal/60 mb-4">
        Deduct <strong>20%</strong> of your rent (up to <strong>₦500k</strong>) from your taxable income!
      </p>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-bold text-charcoal/50 select-none pointer-events-none">₦</span>
        <input
          id="rentPaid"
          type="text"
          inputmode="numeric"
          placeholder="e.g. 1,200,000"
          autocomplete="off"
          class="neo-input w-full pl-10 pr-4 py-4 text-xl font-bold text-charcoal bg-cream placeholder:text-charcoal/25 focus:outline-none focus:ring-2 focus:ring-ng-green/40"
        />
      </div>
    </div>

    <!-- Pension toggle -->
    <div class="flex items-center justify-between p-4 rounded-xl bg-cream border-2 border-charcoal">
      <div>
        <p class="font-bold text-charcoal text-base">Include 8% Pension Deduction</p>
        <p class="text-xs text-charcoal/55">Standard contributory pension scheme</p>
      </div>
      <button
        id="pensionToggle"
        type="button"
        role="switch"
        aria-checked="true"
        class="relative inline-flex h-8 w-14 shrink-0 cursor-pointer rounded-full border-2 border-charcoal bg-ng-green transition-colors duration-200 ease-in-out"
      >
        <span
          id="pensionKnob"
          class="pointer-events-none inline-block h-6 w-6 translate-x-6 transform rounded-full bg-white border-2 border-charcoal shadow-sm transition-transform duration-200 ease-in-out mt-px"
        ></span>
      </button>
    </div>
  </div>

  <!-- RESULTS SECTION (hidden until income > 0) -->
  <div id="resultsSection" class="hidden opacity-0 translate-y-6 transition-all duration-500 space-y-8">

    <!-- Divider -->
    <div class="flex items-center gap-4">
      <div class="flex-1 h-0.75 bg-charcoal rounded"></div>
      <span class="text-sm font-extrabold text-charcoal uppercase tracking-widest">Your Breakdown</span>
      <div class="flex-1 h-0.75 bg-charcoal rounded"></div>
    </div>

    <!--  Top Metric Cards  -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <!-- Net Take-Home -->
      <div class="neo-card bg-ng-green p-5 sm:p-6 text-white">
        <p class="text-sm font-bold uppercase tracking-wider opacity-80 mb-1">Net Take-Home</p>
        <p id="metricNet" class="text-2xl sm:text-3xl font-black leading-tight">₦0</p>
        <p class="text-xs mt-1 opacity-70">Monthly: <span id="metricNetMonthly">₦0</span></p>
      </div>
      <!-- Total PAYE Tax -->
      <div class="neo-card bg-charcoal p-5 sm:p-6 text-white">
        <p class="text-sm font-bold uppercase tracking-wider opacity-80 mb-1">PAYE Tax</p>
        <p id="metricTax" class="text-2xl sm:text-3xl font-black leading-tight">₦0</p>
        <p class="text-xs mt-1 opacity-70">Monthly: <span id="metricTaxMonthly">₦0</span></p>
      </div>
      <!-- Effective Rate -->
      <div class="neo-card bg-white p-5 sm:p-6 text-charcoal border-ng-green border-[3px]">
        <p class="text-sm font-bold uppercase tracking-wider text-charcoal/60 mb-1">Effective Tax Rate</p>
        <p id="metricRate" class="text-2xl sm:text-3xl font-black text-ng-green leading-tight">0%</p>
        <p class="text-xs mt-1 text-charcoal/50">As a % of gross income</p>
      </div>
    </div>

    <!--  Chart + Band Table ─ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Donut Chart Card -->
      <div class="neo-card bg-white p-6 sm:p-8 flex flex-col items-center">
        <h2 class="text-lg font-extrabold text-charcoal mb-4 self-start">Income Allocation</h2>
        <div class="relative w-64 h-64 sm:w-72 sm:h-72">
          <svg id="donutChart" viewBox="0 0 200 200" class="w-full h-full transform -rotate-90">
            <!-- Slices will be generated by JS -->
          </svg>
          <!-- Center label -->
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-xs font-bold text-charcoal/50 uppercase tracking-wide">Gross</span>
            <span id="chartCenter" class="text-lg sm:text-xl font-black text-charcoal">₦0</span>
          </div>
        </div>
        <!-- Legend -->
        <div id="chartLegend" class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2 text-sm font-semibold text-charcoal w-full"></div>
      </div>

      <!-- Tax Bands Table -->
      <div class="neo-card bg-white p-6 sm:p-8">
        <h2 class="text-lg font-extrabold text-charcoal mb-4">Progressive Tax Bands</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-[3px] border-charcoal">
                <th class="text-left py-2 font-extrabold text-charcoal">Band</th>
                <th class="text-right py-2 font-extrabold text-charcoal">Rate</th>
                <th class="text-right py-2 font-extrabold text-charcoal">Taxable</th>
                <th class="text-right py-2 font-extrabold text-charcoal">Tax</th>
              </tr>
            </thead>
            <tbody id="bandsBody">
              <!-- Rows generated by JS -->
            </tbody>
          </table>
        </div>

        <!-- Deductions summary -->
        <div class="mt-6 space-y-2 pt-4 border-t-[3px] border-charcoal/20">
          <h3 class="text-sm font-extrabold text-charcoal uppercase tracking-wider mb-2">Deductions Applied</h3>
          <div class="flex justify-between text-sm">
            <span class="text-charcoal/70">Pension (8%)</span>
            <span id="deductPension" class="font-bold text-charcoal">₦0</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-charcoal/70">Rent Relief (20%, max ₦500k)</span>
            <span id="deductRent" class="font-bold text-charcoal">₦0</span>
          </div>
          <div class="flex justify-between text-sm pt-2 border-t border-charcoal/10">
            <span class="font-bold text-charcoal">Total Deductions</span>
            <span id="deductTotal" class="font-bold text-ng-green">₦0</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CLIENT-SIDE SCRIPT — vanilla TypeScript, no frameworks -->
<script>
  import { calculatePAYE, formatNaira, type TaxInput, type TaxOutput } from '../utils/taxEngine';

  //  DOM Refs
  const $gross        = document.getElementById('grossIncome') as HTMLInputElement;
  const $rent         = document.getElementById('rentPaid') as HTMLInputElement;
  const $pensionBtn   = document.getElementById('pensionToggle') as HTMLButtonElement;
  const $pensionKnob  = document.getElementById('pensionKnob') as HTMLSpanElement;
  const $deductCard   = document.getElementById('deductionsCard') as HTMLDivElement;
  const $results      = document.getElementById('resultsSection') as HTMLDivElement;
  const $metricNet    = document.getElementById('metricNet')!;
  const $metricNetM   = document.getElementById('metricNetMonthly')!;
  const $metricTax    = document.getElementById('metricTax')!;
  const $metricTaxM   = document.getElementById('metricTaxMonthly')!;
  const $metricRate   = document.getElementById('metricRate')!;
  const $chartCenter  = document.getElementById('chartCenter')!;
  const $donut        = document.getElementById('donutChart') as unknown as SVGSVGElement;
  const $legend       = document.getElementById('chartLegend')!;
  const $bandsBody    = document.getElementById('bandsBody')!;
  const $deductPen    = document.getElementById('deductPension')!;
  const $deductRent   = document.getElementById('deductRent')!;
  const $deductTotal  = document.getElementById('deductTotal')!;

  //  State
  let pensionOn = true;

  //  Helpers

  /** Parse a formatted number string: "5,000,000" → 5000000 */
  function parseNum(s: string): number {
    return Number(s.replace(/[^0-9.]/g, '')) || 0;
  }

  /** Format input as user types (add commas) */
  function formatInputValue(input: HTMLInputElement) {
    const raw = input.value.replace(/[^0-9]/g, '');
    if (!raw) { input.value = ''; return; }
    const n = parseInt(raw, 10);
    const caretFromEnd = input.value.length - (input.selectionStart ?? input.value.length);
    input.value = n.toLocaleString('en-NG');
    // Try to keep caret position sensible
    const newPos = Math.max(0, input.value.length - caretFromEnd);
    input.setSelectionRange(newPos, newPos);
  }

  /** Show/hide an element with animation classes */
  function reveal(el: HTMLElement) {
    el.classList.remove('hidden');
    requestAnimationFrame(() => {
      el.classList.remove('opacity-0', 'translate-y-6');
      el.classList.add('opacity-100', 'translate-y-0');
    });
  }
  function conceal(el: HTMLElement) {
    el.classList.add('opacity-0', 'translate-y-6');
    el.addEventListener('transitionend', () => {
      if (el.classList.contains('opacity-0')) {
        el.classList.add('hidden');
      }
    }, { once: true });
  }

  //  Chart Rendering 

  const SLICE_COLORS = [
    { color: '#00A86B', label: 'Net Take-Home' },
    { color: '#121212', label: 'PAYE Tax' },
    { color: '#3B82F6', label: 'Pension' },
    { color: '#F59E0B', label: 'Rent Relief' },
  ];

  function renderDonut(result: TaxOutput) {
    const gross = result.grossIncome;
    if (gross <= 0) return;

    const slices = [
      { value: result.netIncome,          ...SLICE_COLORS[0] },
      { value: result.totalTax,           ...SLICE_COLORS[1] },
      { value: result.pensionDeduction,   ...SLICE_COLORS[2] },
      { value: result.rentRelief,         ...SLICE_COLORS[3] },
    ].filter(s => s.value > 0);

    const total = slices.reduce((s, x) => s + x.value, 0);
    const cx = 100, cy = 100, r = 70;
    const circumference = 2 * Math.PI * r;
    const gap = 4; // gap in SVG units between slices

    // Calculate the total gap space
    const totalGap = gap * slices.length;
    const availableCircumference = circumference - totalGap;

    let svgContent = '';
    let offset = 0;

    for (const slice of slices) {
      const pct = slice.value / total;
      const dash = pct * availableCircumference;

      svgContent += `
        <circle
          cx="${cx}" cy="${cy}" r="${r}"
          fill="none"
          stroke="${slice.color}"
          stroke-width="28"
          stroke-dasharray="${dash} ${circumference - dash}"
          stroke-dashoffset="${-offset}"
          class="transition-all duration-500 ease-out"
        />
      `;
      offset += dash + gap;
    }

    $donut.innerHTML = svgContent;

    // Legend
    $legend.innerHTML = slices.map(s => `
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-sm border-2 border-charcoal shrink-0" style="background:${s.color}"></span>
        <span class="text-charcoal/80">${s.label}</span>
        <span class="ml-auto font-bold text-charcoal">${((s.value / total) * 100).toFixed(1)}%</span>
      </div>
    `).join('');
  }

    //  Band Table Rendering
  function renderBands(result: TaxOutput) {
    $bandsBody.innerHTML = result.bands.map((b, i) => {
      const highlight = b.taxOnBand > 0 ? 'bg-cream' : '';
      const rateStr = (b.rate * 100).toFixed(0) + '%';
      return `
        <tr class="${highlight} border-b border-charcoal/10 transition-colors">
          <td class="py-2.5 pr-2 text-charcoal/80 font-medium">${b.label}</td>
          <td class="py-2.5 text-right font-bold ${b.rate === 0 ? 'text-ng-green' : 'text-charcoal'}">${b.rate === 0 ? 'FREE' : rateStr}</td>
          <td class="py-2.5 text-right font-semibold text-charcoal/70">${formatNaira(b.taxableInBand)}</td>
          <td class="py-2.5 text-right font-bold text-charcoal">${formatNaira(b.taxOnBand)}</td>
        </tr>
      `;
    }).join('');

    // Total row
    $bandsBody.innerHTML += `
      <tr class="border-t-[3px] border-charcoal">
        <td class="py-2.5 font-extrabold text-charcoal" colspan="3">Total PAYE Tax</td>
        <td class="py-2.5 text-right font-black text-charcoal text-base">${formatNaira(result.totalTax)}</td>
      </tr>
    `;
  }

  //  Main Update
  function update() {
    const grossIncome = parseNum($gross.value);
    const rentPaid = parseNum($rent.value);

    // Show/hide deductions card
    if (grossIncome > 800_000) {
      reveal($deductCard);
    } else {
      if (!$deductCard.classList.contains('hidden')) conceal($deductCard);
    }

    // Show/hide results
    if (grossIncome > 0) {
      reveal($results);
    } else {
      if (!$results.classList.contains('hidden')) conceal($results);
      return;
    }

    const input: TaxInput = {
      grossIncome,
      rentPaid,
      includePension: pensionOn,
    };

    const result = calculatePAYE(input);

    // Update Metrics
    $metricNet.textContent = formatNaira(result.netIncome);
    $metricNetM.textContent = formatNaira(result.netIncome / 12);
    $metricTax.textContent = formatNaira(result.totalTax);
    $metricTaxM.textContent = formatNaira(result.totalTax / 12);
    $metricRate.textContent = result.effectiveRate + '%';
    $chartCenter.textContent = formatNaira(result.grossIncome);

    // Update Deductions
    $deductPen.textContent = formatNaira(result.pensionDeduction);
    $deductRent.textContent = formatNaira(result.rentRelief);
    $deductTotal.textContent = formatNaira(result.totalDeductions);

    // Render Chart & Table
    renderDonut(result);
    renderBands(result);
  }

  //  Event Listeners 

  // Format & recalculate on every keystroke
  $gross.addEventListener('input', () => { formatInputValue($gross); update(); });
  $rent.addEventListener('input', () => { formatInputValue($rent); update(); });

  // Pension toggle
  $pensionBtn.addEventListener('click', () => {
    pensionOn = !pensionOn;
    $pensionBtn.setAttribute('aria-checked', String(pensionOn));
    if (pensionOn) {
      $pensionBtn.classList.add('bg-ng-green');
      $pensionBtn.classList.remove('bg-charcoal/20');
      $pensionKnob.classList.add('translate-x-6');
      $pensionKnob.classList.remove('translate-x-0');
    } else {
      $pensionBtn.classList.remove('bg-ng-green');
      $pensionBtn.classList.add('bg-charcoal/20');
      $pensionKnob.classList.remove('translate-x-6');
      $pensionKnob.classList.add('translate-x-0');
    }
    update();
  });

  // Initial render (empty state)
  update();
</script>
